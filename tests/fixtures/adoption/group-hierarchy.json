    "rejectionExamples": [
        {
            "exampleId": "cyclic_group_reference",
            "description": "Group A lists Group B as a child, and Group B lists Group A as a child, creating a graph cycle.",
            "inputMutation": {
                "grp_root": {
                    "children": [
                        "grp_sub"
                    ],
                    "parentGroup": "grp_sub"
                },
                "grp_sub": {
                    "children": [
                        "grp_root"
                    ],
                    "parentGroup": "grp_root"
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::references (lines 177-185)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "cyclic-group",
            "failureMechanism": "DocumentSchema::references traverses ancestor chain ($parents[$cursor]) with a $seen set; encountering an already-seen ancestor throws 'cyclic-group'."
        },
        {
            "exampleId": "inconsistent_parent_group_pointer",
            "description": "Child layer specifies parentGroup 'grp_root', but 'grp_root' does not list the layer in its children array.",
            "inputMutation": {
                "layer_header": {
                    "parentGroup": "grp_unrelated"
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::references (lines 173-176)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "inconsistent-group-parent",
            "failureMechanism": "DocumentSchema::references verifies that ($layer->parentGroup ?? null) === ($parents[$id] ?? null). A mismatch throws 'inconsistent-group-parent'."
        },
        {
            "exampleId": "children_on_non_group_layer",
            "description": "A layer of type 'rectangle' or 'text' declares a 'children' property.",
            "inputMutation": {
                "layer_card": {
                    "type": "rectangle",
                    "children": [
                        "layer_icon"
                    ]
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::references (lines 159-162)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "children-require-group",
            "failureMechanism": "DocumentSchema::references checks if ($layer->type !== 'group') when isset($layer->children) and throws 'children-require-group'."
        },
        {
            "exampleId": "historical_renderer_group_block",
