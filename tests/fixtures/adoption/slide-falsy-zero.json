    "rejectionExamples": [
        {
            "exampleId": "slide_with_source_block",
            "description": "A slide surface contains an illegal 'source' property (even if null or empty).",
            "inputMutation": {
                "source": null
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::surface (lines 89-91)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "slide-must-not-have-source",
            "failureMechanism": "DocumentSchema::surface explicitly checks property_exists($surface, 'source') when kind === 'slide' and throws 'slide-must-not-have-source'. Slides have no media backing and cannot declare a file source."
        },
        {
            "exampleId": "null_background_color",
            "description": "Canvas backgroundColor is passed as null instead of a valid color string.",
            "inputMutation": {
                "canvas": {
                    "backgroundColor": null
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::surface (line 78)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "invalid-background",
            "failureMechanism": "DocumentSchema::surface requires is_string($surface->canvas->backgroundColor) && ColorValidator::isValidColor(...). Null values fail immediately."
        },
        {
            "exampleId": "string_boolean_background_visible",
            "description": "backgroundVisible is passed as string 'false' rather than native boolean false.",
            "inputMutation": {
                "canvas": {
                    "backgroundVisible": "false"
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::surface (line 80)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "invalid-background",
            "failureMechanism": "DocumentSchema::surface requires is_bool($surface->canvas->backgroundVisible). Coercion from strings is rejected."
        },
        {
            "exampleId": "negative_background_opacity",
            "description": "backgroundOpacity is negative (-0.05).",
            "inputMutation": {
                "canvas": {
                    "backgroundOpacity": -0.05
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::surface (line 86)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "invalid-background-opacity",
            "failureMechanism": "DocumentSchema::surface requires opacity >= 0 && opacity <= 1."
        }
    ]
