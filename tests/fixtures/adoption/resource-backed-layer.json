    "rejectionExamples": [
        {
            "exampleId": "svg_data_url_xss_prevention",
            "description": "Image layer src uses an SVG data URL (data:image/svg+xml;base64,...), which is strictly forbidden due to script execution risks.",
            "inputMutation": {
                "src": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxzY3JpcHQ+YWxlcnQoMSk8L3NjcmlwdD48L3N2Zz4="
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Validation\\ServerSideLayerValidator::validateImageSrc (lines 648-651)",
            "expectedException": "ApiUsageException",
            "expectedErrorCode": "validationfailed",
            "failureMechanism": "validateImageSrc enforces strict MIME whitelist: image/png, image/jpeg, image/gif, image/webp. SVG is excluded because SVG data URLs can contain executable JavaScript."
        },
        {
            "exampleId": "corrupted_image_magic_bytes",
            "description": "Image layer declares data:image/png;base64, but payload bytes do not start with the PNG file signature (\\x89PNG\\r\\n\\x1a\\n).",
            "inputMutation": {
                "src": "data:image/png;base64,SGVsbG8gV29ybGQ="
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Validation\\ServerSideLayerValidator::matchesImageSignature (lines 687-688)",
            "expectedException": "ApiUsageException",
            "expectedErrorCode": "validationfailed",
            "failureMechanism": "matchesImageSignature verifies that decoded binary starts with 8-byte PNG signature. Spoofed MIME types fail validation."
        },
