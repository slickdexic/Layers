    "rejectionExamples": [
        {
            "exampleId": "unknown_layer_property",
            "description": "Layer contains an unknown experimental property not in ServerSideLayerValidator::ALLOWED_PROPERTIES.",
            "inputMutation": {
                "calloutGlowEffect": true,
                "customTooltip": "Inspect here"
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::layers",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "invalid-or-lossy-layer-data",
            "failureMechanism": "ServerSideLayerValidator drops unknown properties. DocumentSchema compares JsonSnapshotCodec::encode($surface->layers) against JsonSnapshotCodec::encode($sanitizedResult); because properties were stripped, they do not match, failing validation without silent data loss."
        },
        {
            "exampleId": "invalid_tail_direction_enum",
            "description": "Callout layer contains an unapproved tailDirection enum value.",
            "inputMutation": {
                "tailDirection": "diagonal-down-left"
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Validation\\ServerSideLayerValidator::validateStringProperty",
            "expectedException": "ApiUsageException",
            "expectedErrorCode": "validationfailed",
            "failureMechanism": "VALUE_CONSTRAINTS['tailDirection'] enforces one of ['bottom', 'top', 'left', 'right', 'bottom-left', 'bottom-right', 'top-left', 'top-right']. Non-matching value fails validation."
        },
        {
            "exampleId": "fractional_canvas_dimension",
            "description": "Canvas width is specified as a floating point number rather than an integer.",
            "inputMutation": {
                "canvas": {
                    "width": 1920.5,
                    "height": 1080
                }
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::integer",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "invalid-canvas-dimension",
            "failureMechanism": "DocumentSchema::integer requires is_int($value). Floats fail the integer type check even if numeric."
        },
        {
            "exampleId": "historical_renderer_surface_gate",
            "description": "The page-owned revision renderer currently blocks image surfaces.",
            "inputMutation": [],
            "failingSubsystem": "resources/ext.layers/viewer/PageOwnedRevisionRenderer.js (line 44)",
            "expectedException": "Error",
            "expectedErrorCode": "Unsupported historical surface",
            "failureMechanism": "PageOwnedRevisionRenderer line 44 explicitly checks if (surface.kind !== 'slide') and throws, because pinned source delivery for image assets is not yet integrated."
        }
