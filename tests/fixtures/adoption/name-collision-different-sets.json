    "rejectionExamples": [
        {
            "exampleId": "duplicate_surface_id_collision",
            "description": "Adoption converter naively reuses identical legacy set names as surface IDs ('default' and 'default') in the page-owned document.",
            "inputMutation": {
                "surfaces": [
                    {
                        "id": "default",
                        "kind": "image"
                    },
                    {
                        "id": "default",
                        "kind": "image"
                    }
                ]
            },
            "failingSubsystem": "MediaWiki\\Extension\\Layers\\Revision\\DocumentSchema::canonicalize (lines 45-48)",
            "expectedException": "InvalidArgumentException",
            "expectedErrorCode": "duplicate-surface-id",
            "failureMechanism": "DocumentSchema::canonicalize tracks seen surface IDs ($ids[$surface->id]); encountering a second surface with the same id immediately throws 'duplicate-surface-id'."
        },
        {
            "exampleId": "duplicate_layer_id_within_surface",
